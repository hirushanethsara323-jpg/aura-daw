# Build directories (CMake presets use their own)
/build/
/build-*/
/_deps/
CMakeUserPresets.json

# Editor / IDE
.vs/
.vscode/
.idea/
*.user
*.suo
compile_commands.json

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Test and tool output that must never be committed
*.wav
# ...except the fuzz corpus, which is committed input data: a WAV seed is a test
# fixture that happens to have the same extension as render output.
!fuzz/corpus/wav/*.wav
*.aurapeaks
*.dmp
/build/Testing/

# Python bytecode (tools/ are run, not built)
__pycache__/
*.pyc
